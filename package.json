{
  "name": "docsender",
  "version": "1.2.0",
  "description": "Envio Automático de Documentos PDF",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.onechat.docsender",
    "productName": "DocSender",
    "copyright": "Copyright © 2026 OneChat",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/logo.png",
      "target": "nsis",
      "legalTrademarks": "DocSender é uma marca da OneChat",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "publisherName": "OneChat"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DocSender"
    }
  },
  "author": "OneChat",
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.20.0",
    "chokidar": "^4.0.3",
    "electron-store": "^8.2.0",
    "form-data": "^4.0.6",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  }
}
